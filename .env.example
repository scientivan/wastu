# Salin file ini menjadi .env dan isi nilai sebenarnya hanya di .env.
# Gunakan format Npgsql, bukan URL PostgreSQL.
# Ganti host, username, dan password sesuai konfigurasi proyek Supabase.
# Contoh session pooler, sesuaikan region dan project reference.
# WASTU_CONNECTION_STRING='Host=aws-0-REGION.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.PROJECT_REF;Password=YOUR_DATABASE_PASSWORD;SSL Mode=Require'
WASTU_CONNECTION_STRING=
host=aws-0-REGION.pooler.supabase.com
port=5432
database=postgres
user=postgres.PROJECT_REF
password=


# Opsional, kosong memakai folder data aplikasi bawaan.
WASTU_DATA_DIR=

# Aplikasi membaca .env otomatis dari direktori kerja atau direktori executable
# dan folder induknya. Environment variable yang terisi lebih diutamakan.
# Connection string lengkap yang terisi mengesampingkan variabel terpisah.
# Gunakan kutip tunggal atau ganda untuk nilai yang memuat spasi atau komentar.
