<p:PageBase x:Class="Wastu.Views.Pages.ReportPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:Wastu.Controls"
            xmlns:p="clr-namespace:Wastu.Views.Pages">
    <p:PageBase.Resources>
        <Style x:Key="ReportTitle" TargetType="c:TrackedText">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="650" />
            <Setter Property="Tracking" Value="-0.56" />
            <Setter Property="LineHeight" Value="22.4" />
            <Setter Property="Margin" Value="0,22,0,16" />
        </Style>
        <Style x:Key="Th" TargetType="c:CssText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Leading" Value="1.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Td" TargetType="c:CssText">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="12,14" />
            <Setter Property="Leading" Value="1.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Body" TargetType="c:CssText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Leading" Value="1.6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="BadgeTersedia" TargetType="Border">
            <Setter Property="Background" Value="#DCFCE7" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
        <Style x:Key="BadgeHilang" TargetType="Border">
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
        </Style>
    </p:PageBase.Resources>

    <StackPanel>
        <c:PageHeading x:Name="Heading" Title="Laporan proyek" Description="Ringkasan proyek, profil iklim, material terpilih, proyeksi emisi, dan tanggal terkunci.">
            <Button Style="{StaticResource Btn}" Content="Simpan PDF" Click="ExportPdf_Click" />
        </c:PageHeading>

        <!-- Opsi Pilihan Ekspor -->
        <Border Style="{StaticResource Panel}" Margin="0,0,0,18">
            <StackPanel>
                <c:TrackedText Style="{StaticResource PanelTitle}" Text="Pengaturan Ekspor PDF" Margin="0,0,0,12" />

                <c:FlowGrid Columns="3" ColumnGap="20" Stretch="False" Margin="0,0,0,14">
                    <StackPanel>
                        <c:CssText Text="Komponen Aktif" FontWeight="700" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CompWallRadio" Content="Dinding" GroupName="CompGroup" Checked="Comp_Checked" Tag="Dinding" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="CompRoofRadio" Content="Atap" GroupName="CompGroup" Checked="Comp_Checked" Tag="Atap" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <c:CssText Text="Horizon Simulasi" FontWeight="700" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="Hor20Radio" Content="20 thn" GroupName="HorGroup" Checked="Horizon_Checked" Tag="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="Hor30Radio" Content="30 thn" GroupName="HorGroup" Checked="Horizon_Checked" Tag="30" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <RadioButton x:Name="Hor50Radio" Content="50 thn" GroupName="HorGroup" Checked="Horizon_Checked" Tag="50" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel>
                        <c:CssText Text="Jadwal Lapangan" FontWeight="700" Margin="0,0,0,6" />
                        <CheckBox x:Name="IncludeScheduleCheck" Content="Sertakan jadwal terkunci" IsChecked="True" Click="ScheduleCheck_Click" VerticalAlignment="Center" />
                    </StackPanel>
                </c:FlowGrid>

                <c:CssText Text="Pilih Material untuk Laporan (Dapat memilih material apa pun termasuk peringkat 10):" FontWeight="700" Margin="0,0,0,8" />
                <ItemsControl x:Name="MaterialCheckList" ItemsSource="{Binding SelectableMaterials}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="MaterialCheck_Click" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <c:CssText Grid.Column="1" Text="{Binding RankText}" FontWeight="600" VerticalAlignment="Center" />
                                    <c:CssText Grid.Column="2" Text="{Binding Name}" FontWeight="600" VerticalAlignment="Center" />
                                    <c:CssText Grid.Column="3" Text="{Binding ScoreText}" VerticalAlignment="Center" />
                                    <c:CssText Grid.Column="4" Text="{Binding EmissionText}" VerticalAlignment="Center" />
                                    <c:CssText Grid.Column="5" Text="{Binding ReasonPreview}" TextWrapping="Wrap" VerticalAlignment="Center" Style="{StaticResource Small}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- #report Preview -->
        <Border x:Name="Report" Style="{StaticResource Panel}" Margin="0,0,0,18">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Image Source="{StaticResource Logo}" Width="43" Height="43" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <c:TrackedText Text="Laporan Rekomendasi Wastu" FontSize="21" FontWeight="650" Tracking="-0.735" />
                        <c:CssText Text="{Binding Subtitle}" Style="{StaticResource Small}" Strut="14" />
                    </StackPanel>
                </StackPanel>

                <c:FlowGrid Columns="2" ColumnGap="20" Stretch="False">
                    <Border Style="{StaticResource MiniStat}">
                        <StackPanel>
                            <c:CssText Text="Lokasi" FontWeight="700" />
                            <c:CssText Style="{StaticResource Body}" Text="{Binding Location}" />
                            <c:CssText Style="{StaticResource Small}" Strut="14" Text="{Binding Areas}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MiniStat}">
                        <StackPanel>
                            <c:CssText Text="Iklim" FontWeight="700" />
                            <c:CssText Style="{StaticResource Body}" Text="{Binding Climate}" />
                            <c:CssText Style="{StaticResource Small}" Strut="14" Text="{Binding ClimateDetail}" Visibility="{Binding HasClimate}" />
                        </StackPanel>
                    </Border>
                </c:FlowGrid>

                <c:TrackedText Style="{StaticResource ReportTitle}" Text="{Binding RankingTitle}" />
                <Grid Background="{StaticResource TableHead}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="157*" />
                        <ColumnDefinition Width="67*" />
                        <ColumnDefinition Width="94*" />
                        <ColumnDefinition Width="768*" />
                    </Grid.ColumnDefinitions>
                    <c:CssText Style="{StaticResource Th}" Text="Material" />
                    <c:CssText Style="{StaticResource Th}" Grid.Column="1" Text="Skor" />
                    <c:CssText Style="{StaticResource Th}" Grid.Column="2" Text="kgCO₂e awal" />
                    <c:CssText Style="{StaticResource Th}" Grid.Column="3" Text="Alasan" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="{Binding RowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="157*" />
                                        <ColumnDefinition Width="67*" />
                                        <ColumnDefinition Width="94*" />
                                        <ColumnDefinition Width="768*" />
                                    </Grid.ColumnDefinitions>
                                    <c:CssText Style="{StaticResource Td}" Text="{Binding Name}" />
                                    <c:CssText Style="{StaticResource Td}" Grid.Column="1" Text="{Binding Score}" />
                                    <c:CssText Style="{StaticResource Td}" Grid.Column="2" Text="{Binding Emission}" />
                                    <c:CssText Style="{StaticResource Td}" Grid.Column="3" Text="{Binding Reason}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <c:TrackedText Style="{StaticResource ReportTitle}" Text="{Binding SimulationTitle}" Margin="0,18,0,16" />
                <ItemsControl ItemsSource="{Binding Simulations}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <c:FlowGrid Columns="2" ColumnGap="20" Stretch="False" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MiniStat}">
                                <StackPanel>
                                    <c:CssText Text="{Binding Name}" FontWeight="700" />
                                    <c:TrackedText Text="{Binding Total}" FontSize="16" FontWeight="650" Tracking="-0.56" LineHeight="22.4" Margin="0,7" />
                                    <c:CssText Style="{StaticResource Small}" Strut="14" Text="{Binding Detail}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <c:TrackedText Style="{StaticResource ReportTitle}" Text="Jadwal terkunci" Margin="0,18,0,16" />
                <ItemsControl ItemsSource="{Binding Locked}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <c:CssText Style="{StaticResource Body}" Text="{Binding}" Margin="0,0,0,14" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <c:CssText Style="{StaticResource MutedLine}" Text="Belum ada tanggal terkunci." Visibility="{Binding NoLocked}" Margin="0,0,0,12" />
            </StackPanel>
        </Border>

        <!-- Riwayat Laporan Section -->
        <Border Style="{StaticResource Panel}">
            <StackPanel>
                <c:TrackedText Style="{StaticResource PanelTitle}" Text="Riwayat Laporan PDF" Margin="0,0,0,12" />
                <c:CssText Text="Daftar berkas PDF rekomendasi yang pernah diekspor untuk proyek ini:" Style="{StaticResource Small}" Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding ReportHistory}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <c:CssText Text="{Binding NamaBerkas}" FontWeight="700" FontSize="14" Margin="0,0,10,0" />
                                            <Border Style="{Binding BadgeStyle}" VerticalAlignment="Center">
                                                <c:CssText Text="{Binding StatusTeks}" FontSize="11" FontWeight="600" Foreground="{Binding StatusFg}" />
                                            </Border>
                                        </StackPanel>
                                        <c:CssText Text="{Binding TanggalFormat}" Style="{StaticResource Small}" Margin="0,0,0,2" />
                                        <c:CssText Text="{Binding Selection}" Style="{StaticResource Small}" Margin="0,0,0,2" TextWrapping="Wrap" />
                                        <c:CssText Text="{Binding PathBerkas}" Style="{StaticResource Small}" Foreground="{StaticResource Muted}" />
                                        <c:CssText Text="⚠️ Berkas PDF tidak ditemukan pada lokasi ini. Berkas mungkin telah dipindahkan atau dihapus."
                                                   Visibility="{Binding MissingVisibility}"
                                                   Foreground="#B91C1C" FontSize="12" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Button Style="{StaticResource BtnLight}" Content="Buka PDF" Click="OpenPdf_Click" />
                                        <Button Style="{StaticResource BtnLight}" Content="Buat salinan" IsEnabled="{Binding HasSnapshot}"
                                                ToolTip="Memakai angka, sumber, dan asumsi asli laporan; pilih lokasi baru jika berkas hilang."
                                                Margin="8,0,0,0" Click="RegeneratePdf_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <c:CssText Text="Belum ada laporan PDF yang diekspor untuk proyek ini." Visibility="{Binding NoHistory}" Style="{StaticResource MutedLine}" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</p:PageBase>
