<p:PageBase x:Class="Wastu.Views.Pages.ComparePage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:Wastu.Controls"
            xmlns:p="clr-namespace:Wastu.Views.Pages">
    <p:PageBase.Resources>
        <Style x:Key="Th" TargetType="c:CssText">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="600" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="12" />
            <Setter Property="Leading" Value="1.5" />
        </Style>
    </p:PageBase.Resources>

    <StackPanel>
        <c:PageHeading Title="Bandingkan material" Description="{Binding Description}">
            <Border Style="{StaticResource Seg}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WallTab" Style="{StaticResource SegItem}" Content="Dinding" Tag="Dinding" Click="Kind_Click" Margin="0,0,4,0" />
                    <RadioButton x:Name="RoofTab" Style="{StaticResource SegItem}" Content="Atap" Tag="Atap" Click="Kind_Click" />
                </StackPanel>
            </Border>
        </c:PageHeading>

        <!-- Panel Pengaturan Bobot Kriteria (F4-04, F4-05, T16, T17) -->
        <Border Style="{StaticResource Panel}" Margin="0,0,0,22" Padding="20">
            <StackPanel>
                <StackPanel Margin="0,0,0,14">
                    <StackPanel>
                        <c:TrackedText Style="{StaticResource PanelTitle}" Text="Bobot Kriteria Kesesuaian" Margin="0,0,0,4" />
                        <c:CssText Text="Atur tingkat kepentingan relatif untuk keempat kriteria penilaian iklim." FontSize="12" Foreground="{StaticResource Muted}" Leading="1.4" />
                    </StackPanel>
                    <Border Style="{StaticResource Seg}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MvpWeightRadio" Style="{StaticResource SegItem}" Content="Mode MVP (Bobot sama 25%)" Click="WeightMode_Click" Tag="mvp" Margin="0,0,4,0" />
                            <RadioButton x:Name="V2WeightRadio" Style="{StaticResource SegItem}" Content="Mode V2 (Bobot kustom per proyek)" Click="WeightMode_Click" Tag="v2" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Panel Tampilan Mode MVP -->
                <Border x:Name="MvpWeightInfoPanel" Background="{StaticResource ChipBg}" CornerRadius="8" Padding="14">
                    <StackPanel Orientation="Horizontal">
                        <c:CssText Text="Mode MVP aktif:" FontWeight="650" FontSize="13" Foreground="{StaticResource Ink}" Margin="0,0,8,0" />
                        <c:CssText Text="Bobot sama untuk empat aspek (25% Termal, 25% Lembap, 25% Korosi, 25% Usia)." FontSize="13" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </Border>

                <!-- Panel Input Mode V2 -->
                <StackPanel x:Name="V2WeightControlPanel" Margin="0,4,0,0">
                    <c:FlowGrid Columns="4" ColumnGap="14" Margin="0,0,0,12">
                        <StackPanel>
                            <c:CssText Style="{StaticResource FormLabel}" Text="Termal %" />
                            <TextBox x:Name="ThermalWeightBox" AutomationProperties.Name="Bobot termal dalam persen" Style="{StaticResource Input}" MinHeight="38" TextChanged="WeightInput_TextChanged" />
                        </StackPanel>
                        <StackPanel>
                            <c:CssText Style="{StaticResource FormLabel}" Text="Lembap %" />
                            <TextBox x:Name="MoistureWeightBox" AutomationProperties.Name="Bobot lembap dalam persen" Style="{StaticResource Input}" MinHeight="38" TextChanged="WeightInput_TextChanged" />
                        </StackPanel>
                        <StackPanel>
                            <c:CssText Style="{StaticResource FormLabel}" Text="Korosi %" />
                            <TextBox x:Name="CorrosionWeightBox" AutomationProperties.Name="Bobot korosi dalam persen" Style="{StaticResource Input}" MinHeight="38" TextChanged="WeightInput_TextChanged" />
                        </StackPanel>
                        <StackPanel>
                            <c:CssText Style="{StaticResource FormLabel}" Text="Usia %" />
                            <TextBox x:Name="LifespanWeightBox" AutomationProperties.Name="Bobot usia pakai dalam persen" Style="{StaticResource Input}" MinHeight="38" TextChanged="WeightInput_TextChanged" />
                        </StackPanel>
                    </c:FlowGrid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="WeightTotalIndicator" FontSize="13" FontWeight="650" Foreground="{StaticResource Green}" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="WeightValidationMessage" FontSize="12" Foreground="{StaticResource Red}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="ResetWeightsBtn" Style="{StaticResource BtnLightSm}" Content="Kembalikan bobot awal" Click="ResetWeights_Click" Margin="0,0,8,0" />
                            <Button x:Name="ApplyWeightsBtn" Style="{StaticResource Btn}" Content="Terapkan Bobot" Click="ApplyWeights_Click" Padding="16,8" MinHeight="34" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Pesan Read-only luring jika ModeBacaSaja -->
                <Border x:Name="WeightReadOnlyBanner" Visibility="Collapsed" Background="{StaticResource WarnBg}" CornerRadius="6" Padding="10,8" Margin="0,10,0,0">
                    <c:CssText Text="Mode luring baca-saja: pengaturan bobot dinonaktifkan." FontSize="12" Foreground="{StaticResource Red}" FontWeight="600" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Panel Transparansi Asumsi Perhitungan (F4-06, §9.1–9.2, X11) -->
        <Border Style="{StaticResource Panel}" Margin="0,0,0,22" Padding="20">
            <Expander Header="Asumsi Perhitungan (v2.0)" IsExpanded="False" Foreground="{StaticResource Ink}" FontSize="15" FontWeight="650">
                <StackPanel Margin="0,14,0,0">
                    <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel>
                            <!-- Beban Lembap -->
                            <StackPanel Margin="0,0,0,14">
                                <c:TrackedText Text="1. Sensitivitas &amp; Beban Lembap" FontSize="13" FontWeight="700" Foreground="{StaticResource Ink}" Margin="0,0,0,4" />
                                <c:CssText Text="Perhitungan beban menggunakan formula komposit terbobot: beban = α · r + (1-α) · h, dengan parameter default α = 0,5 dan acuan curah hujan 3.000 mm/tahun. Nilai α adalah proporsi sensitivitas curah hujan terhadap kelembapan relatif lokasi dan sepenuhnya terpisah dari 4 bobot kriteria penilaian. Model ini adalah model awal pengganti (bukan hasil kalibrasi ilmiah)."
                                           FontSize="12" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Konduktivitas Termal -->
                            <StackPanel Margin="0,0,0,14">
                                <c:TrackedText Text="2. Pita Konduktivitas Termal" FontSize="13" FontWeight="700" Foreground="{StaticResource Ink}" Margin="0,0,0,4" />
                                <c:CssText Text="Pita konduktivitas termal ideal default adalah 0,10 hingga 0,60 W/(m·K) pada suhu rata-rata ≤26°C, dan bergeser secara linear hingga batas atas 0,30 W/(m·K) pada suhu ≥32°C. Bahan dengan konduktivitas di bawah batas atau di dalam pita memperoleh skor penuh 100."
                                           FontSize="12" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Korosi Pesisir -->
                            <StackPanel Margin="0,0,0,14">
                                <c:TrackedText Text="3. Risiko Korosi Pesisir" FontSize="13" FontWeight="700" Foreground="{StaticResource Ink}" Margin="0,0,0,4" />
                                <c:CssText Text="Risiko korosi dihitung sebagai proksi jarak geometris garis pantai kontinu terhadap lokasi proyek dengan batas acuan 50 km (bukan hasil pengukuran salinitas udara langsung di lapangan)."
                                           FontSize="12" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Normalisasi Usia Pakai -->
                            <StackPanel Margin="0,0,0,14">
                                <c:TrackedText Text="4. Normalisasi Usia Pakai" FontSize="13" FontWeight="700" Foreground="{StaticResource Ink}" Margin="0,0,0,4" />
                                <c:CssText Text="Normalisasi usia pakai dihitung secara min–maks terhadap seluruh bahan valid dalam kategori komponen (dinding/atap), bukan hanya bahan hasil penapisan pencarian atau dua bahan yang sedang dibandingkan."
                                           FontSize="12" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Ambang Label -->
                            <StackPanel>
                                <c:TrackedText Text="5. Ambang Kategori Kesesuaian &amp; Versi Model" FontSize="13" FontWeight="700" Foreground="{StaticResource Ink}" Margin="0,0,0,4" />
                                <c:CssText Text="Ambang label kesesuaian konsisten: Cocok (skor ≥ 75), Perlu Pertimbangan (skor 55 hingga 74,99), dan Tidak Disarankan (skor &lt; 55). Seluruh perhitungan berbasis konfigurasi model v2.0."
                                           FontSize="12" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>
        </Border>

        <!-- .compare-controls -->
        <c:FlowGrid Columns="2" ColumnGap="18" Margin="0,0,0,22">
            <StackPanel>
                <c:CssText Style="{StaticResource FormLabel}" Text="Material A" />
                <ComboBox x:Name="SelectA" Style="{StaticResource Select}" Tag="0" SelectionChanged="Select_Changed" />
            </StackPanel>
            <StackPanel>
                <c:CssText Style="{StaticResource FormLabel}" Text="Material B" />
                <ComboBox x:Name="SelectB" Style="{StaticResource Select}" Tag="1" SelectionChanged="Select_Changed" />
            </StackPanel>
        </c:FlowGrid>

        <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:FlowGrid Columns="2" ColumnGap="20" Stretch="False" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- .compare-card -->
                    <Border Style="{StaticResource Panel}" Padding="20">
                        <StackPanel>
                            <!-- img inline: celah descender 3 px + margin 17 -->
                            <Border Height="170" CornerRadius="7" Background="{Binding Image}" Margin="0,0,0,20" />
                            <c:TrackedText Text="{Binding Name}" FontSize="18" FontWeight="650" Tracking="-0.63" Wrap="True" Margin="0,0,0,10" />
                            <ContentPresenter Content="{Binding Tag}" ContentTemplate="{StaticResource TagTemplate}" HorizontalAlignment="Left" />
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,18" Padding="0,17,0,0">
                                <c:FlowGrid Columns="2" ColumnGap="15">
                                    <StackPanel>
                                        <c:CssText Text="Skor iklim" Strut="14" FontSize="12" Foreground="{StaticResource Muted}" />
                                        <c:TrackedText Text="{Binding Score}" Suffix=" / 100" FontSize="25" FontWeight="700" Tracking="-0.6" Margin="0,8,0,0"
                                                       SuffixFontSize="12" SuffixFontWeight="700" SuffixTracking="-0.6" SuffixForeground="{StaticResource Muted}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <c:CssText Text="Emisi awal" Strut="14" FontSize="12" Foreground="{StaticResource Muted}" />
                                        <c:TrackedText Text="{Binding Emission}" Suffix="kgCO₂e" FontSize="25" FontWeight="700" Tracking="-0.6" Margin="0,8,0,0"
                                                       SuffixFontSize="12" SuffixFontWeight="700" SuffixTracking="-0.6" SuffixForeground="{StaticResource Muted}" />
                                    </StackPanel>
                                </c:FlowGrid>
                            </Border>
                            <c:CssText Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource ReasonInk}" Leading="1.75" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <c:CssText Text="{Binding Factor}" Strut="14" FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <Button Style="{StaticResource Btn}" Content="Simulasikan emisi" Tag="sim" Click="Go_Click" />
            <c:CssText Style="{StaticResource MutedLine}" Text="{Binding AreaLabel}" Margin="10,0,0,0" />
        </StackPanel>

        <!-- .compare-table -->
        <Border Style="{StaticResource Panel}" Margin="0,24,0,0">
            <StackPanel>
                <c:TrackedText Style="{StaticResource PanelTitle}" Text="Peringkat kesesuaian iklim" Margin="0,0,0,18" />
                <Grid Background="{StaticResource TableHead}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="501*" />
                        <ColumnDefinition Width="174*" />
                        <ColumnDefinition Width="232*" />
                        <ColumnDefinition Width="179*" />
                    </Grid.ColumnDefinitions>
                    <c:CssText Style="{StaticResource Th}" Text="Material" />
                    <c:CssText Style="{StaticResource Th}" Grid.Column="1" Text="Skor iklim" />
                    <c:CssText Style="{StaticResource Th}" Grid.Column="2" Text="Emisi awal" />
                    <c:CssText Style="{StaticResource Th}" Grid.Column="3" Text="Kesesuaian" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource Line}" BorderThickness="{Binding RowBorder}">
                                <Grid TextElement.FontSize="13">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="501*" />
                                        <ColumnDefinition Width="174*" />
                                        <ColumnDefinition Width="232*" />
                                        <ColumnDefinition Width="179*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="12,14" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="48" Height="40" CornerRadius="5" Background="{Binding Thumb}" />
                                            <c:CssText Text="{Binding Name}" Leading="1.5" FontWeight="700" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <c:CssText Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource Muted}" Leading="1.5" Margin="58,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="12,14" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <c:CssText Text="{Binding Score}" Leading="1.5" FontWeight="650" Foreground="{Binding ScoreBrush}" />
                                            <c:CssText Text=" / 100" Leading="1.5" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Border Width="65" Height="4" CornerRadius="3" Background="{StaticResource ScoreTrack}" HorizontalAlignment="Left" Margin="0,6,0,0">
                                            <Border Width="{Binding BarWidth}" CornerRadius="3" Background="{StaticResource ScoreFill}" HorizontalAlignment="Left" />
                                        </Border>
                                    </StackPanel>
                                    <c:CssText Grid.Column="2" Text="{Binding Emission}" Leading="1.5" Margin="12,14" VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="3" Content="{Binding Tag}" ContentTemplate="{StaticResource TagTemplate}"
                                                      Margin="12,14" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</p:PageBase>
