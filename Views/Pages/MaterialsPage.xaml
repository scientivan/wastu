<p:PageBase x:Class="Wastu.Views.Pages.MaterialsPage"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:c="clr-namespace:Wastu.Controls"
            xmlns:p="clr-namespace:Wastu.Views.Pages">
    <StackPanel>
        <c:PageHeading Title="Eksplor material" Description="Temukan bahan dinding dan atap untuk proyek Anda." />

        <!-- .controls -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
            <Border Style="{StaticResource Seg}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="WallTab" Style="{StaticResource SegItem}" Content="Dinding" Tag="Dinding" Click="Kind_Click" Margin="0,0,4,0" />
                    <RadioButton x:Name="RoofTab" Style="{StaticResource SegItem}" Content="Atap" Tag="Atap" Click="Kind_Click" />
                </StackPanel>
            </Border>
            <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Width="380" Margin="12,0" c:Ui.Placeholder="Cari nama material..."
                     TextChanged="Search_TextChanged" />
            <Border Style="{StaticResource Tag}" Background="{StaticResource TagGoldBg}" TextElement.Foreground="{StaticResource TagGoldFg}">
                <c:CssText x:Name="CountText" Leading="1.4" />
            </Border>
        </StackPanel>

        <ItemsControl x:Name="Cards" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <c:FlowGrid Columns="4" CompactColumns="3" ColumnGap="18" RowGap="18" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- .mat-card -->
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="155" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="9,9,0,0" Background="{Binding Image}" />
                            <Grid Grid.Row="1" Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <c:TrackedText Text="{Binding Kind}" FontSize="10" Tracking="0.4" LineHeight="15.5" Foreground="{StaticResource MutedLineInk}" />
                                <c:TrackedText Grid.Row="1" Text="{Binding Name}" FontSize="15" FontWeight="650" Tracking="-0.525" LineHeight="21" Wrap="True" Margin="0,9" />
                                <ContentPresenter Grid.Row="2" Content="{Binding Tag}" ContentTemplate="{StaticResource TagTemplate}" HorizontalAlignment="Left" />
                                <c:CssText Grid.Row="3" Text="{Binding Reason}" FontSize="12" Foreground="{StaticResource Muted}" Leading="1.6" TextWrapping="Wrap" Margin="0,12,0,17" />
                                <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,13,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <c:TrackedText Text="{Binding Score}" FontSize="19" FontWeight="650" Tracking="-0.5" Foreground="{Binding ScoreBrush}" />
                                            <c:CssText Text="Kesesuaian iklim" FontSize="10" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <c:TrackedText Text="{Binding Emission}" FontSize="19" FontWeight="700" Tracking="-0.5" />
                                            <c:CssText Text="{Binding EmissionLabel}" FontSize="10" Foreground="{StaticResource Muted}" Leading="1.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button Grid.Row="5" Style="{StaticResource BtnLightSm}" Content="Bandingkan material" Tag="{Binding Code}"
                                        HorizontalAlignment="Stretch" Margin="0,17,0,0" Click="Pick_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</p:PageBase>
