<UserControl x:Class="Wastu.Views.RecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Wastu.Controls"
             Background="{StaticResource PaperEntry}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Padding="48,32" BorderBrush="{StaticResource LineEntry}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Image Source="{StaticResource Logo}" Width="40" Height="40" />
                <c:TrackedText Text="Wastu" FontSize="26" FontWeight="750" Tracking="-1" Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Recovery Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,48">
                <StackPanel>
                    <!-- Badge -->
                    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}"
                            BorderThickness="1" CornerRadius="4" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <c:TrackedText Text="PEMULIHAN PENYIMPANAN" FontSize="11" FontWeight="700" Tracking="1" Foreground="{StaticResource Red}" />
                    </Border>

                    <!-- Title -->
                    <c:TrackedText Text="Database tidak dapat diakses." FontSize="28" FontWeight="750" Tracking="-0.5" Margin="0,0,0,14" />

                    <!-- Diagnosis Box -->
                    <Border Background="{StaticResource WarnBg}" BorderBrush="{StaticResource WarnBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <c:TrackedText Text="DIAGNOSIS STATUS" FontSize="10" FontWeight="700" Tracking="1.2" Foreground="{StaticResource Red}" Margin="0,0,0,8" />
                            <c:CssText x:Name="StatusDiagnosisText" FontSize="14" Leading="1.6" Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,0,0,10" />
                            <Border Height="1" Background="{StaticResource WarnBorder}" Margin="0,0,0,10" />
                            <c:CssText x:Name="SnapshotStatusDetailText" FontSize="12" Leading="1.5" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Guidance Box -->
                    <Border Background="{StaticResource White}" BorderBrush="{StaticResource LineEntry}" BorderThickness="1"
                            CornerRadius="8" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <c:TrackedText Text="PANDUAN KONFIGURASI" FontSize="10" FontWeight="700" Tracking="1.2" Foreground="{StaticResource StatusLabel}" Margin="0,0,0,10" />
                            <c:CssText FontSize="13" Leading="1.6" Foreground="{StaticResource Ink}" TextWrapping="Wrap"
                                       Text="1. Pastikan server PostgreSQL aktif dan dapat dijangkau dari jaringan ini.&#10;2. Periksa variabel lingkungan WASTU_CONNECTION_STRING atau berkas konfigurasi .env.&#10;3. Berkas snapshot dan cadangan lokal tetap aman dan tidak pernah dihapus. Tidak ada data contoh tiruan yang dibuat otomatis." />
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="RetryButton" Style="{StaticResource Btn}" MinHeight="44" Padding="24,12" Click="Retry_Click" Margin="0,0,14,0">
                            <c:CssText x:Name="RetryButtonText" Text="Coba Lagi" FontSize="13" FontWeight="600" Foreground="{StaticResource White}" />
                        </Button>
                        <Button x:Name="LocalModeButton" Style="{StaticResource BtnLight}" MinHeight="44" Padding="20,12" Click="LocalMode_Click">
                            <c:CssText Text="Buka Mode Lokal (JSON)" FontSize="13" FontWeight="600" Foreground="{StaticResource Ink}" />
                        </Button>
                    </StackPanel>

                    <!-- Status Notification Text -->
                    <c:CssText x:Name="ActionStatusText" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
