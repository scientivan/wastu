<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Wastu.Controls">

    <Style TargetType="c:PageHeading">
        <Setter Property="Margin" Value="0,0,0,26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:PageHeading">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <c:TrackedText Style="{StaticResource PageTitle}" Text="{TemplateBinding Title}" />
                            <c:CssText Style="{StaticResource PageDesc}" Text="{TemplateBinding Description}" />
                        </StackPanel>
                        <ContentPresenter Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .tag dengan teks dan warna dari TagData. -->
    <DataTemplate x:Key="TagTemplate">
        <Border Style="{StaticResource Tag}" Background="{Binding Bg}" TextElement.Foreground="{Binding Fg}">
            <c:CssText Text="{Binding Text}" Leading="1.4" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
