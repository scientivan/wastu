<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:c="clr-namespace:Wastu.Controls"
                    mc:Ignorable="po">

    <!-- Template ditulis seminimal mungkin: tanpa efek, tanpa animasi, tanpa binding RelativeSource
         pada elemen yang sering dibuat, agar biaya layout/render per kartu tetap kecil. -->

    <!-- :focus-visible { outline: 3px solid; outline-offset: 3px } -->
    <Style x:Key="FocusOutline">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-6" BorderBrush="{StaticResource FocusOutlineBrush}" BorderThickness="3" CornerRadius="14" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FocusOutlineEntry">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-7" BorderBrush="{StaticResource FocusOutlineEntryBrush}" BorderThickness="3" CornerRadius="15" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tombol ===== -->
    <ControlTemplate x:Key="ButtonChrome" TargetType="ButtonBase">
        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding c:Ui.Radius}"
                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
                <Setter Property="Cursor" Value="No" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- .btn -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonChrome}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Background" Value="{StaticResource Green}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green}" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="17,11" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GreenHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BtnLight" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="BorderBrush" Value="{StaticResource LightBorder}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource LightHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BtnWarn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource WarnBg}" />
        <Setter Property="Foreground" Value="{StaticResource Red}" />
        <Setter Property="BorderBrush" Value="{StaticResource WarnBorder}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WarnBg}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="BtnLightSm" TargetType="Button" BasedOn="{StaticResource BtnLight}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>
    <Style x:Key="BtnWarnSm" TargetType="Button" BasedOn="{StaticResource BtnWarn}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <!-- .primary-action (layar pembuka dan formulir) -->
    <Style x:Key="PrimaryAction" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource ButtonChrome}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutlineEntry}" />
        <Setter Property="Background" Value="{StaticResource Green}" />
        <Setter Property="BorderBrush" Value="{StaticResource Green}" />
        <Setter Property="Foreground" Value="{StaticResource White}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="28,14" />
        <Setter Property="MinHeight" Value="49" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="650" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GreenHoverEntry}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="1" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .text-action -->
    <Style x:Key="TextAction" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutlineEntry}" />
        <Setter Property="Foreground" Value="{StaticResource Green}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="0,10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <TextBlock x:Name="Label" Text="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tombol tanpa bingkai (Kelola proyek di sidebar, lokasi di topbar) -->
    <Style x:Key="BareButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .nav button -->
    <Style x:Key="NavItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Foreground" Value="{StaticResource NavFg}" />
        <Setter Property="Background" Value="{StaticResource Clear}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="550" />
        <Setter Property="Padding" Value="12,13" />
        <Setter Property="MinHeight" Value="45" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:Icon Data="{TemplateBinding c:Ui.Icon}" Width="20" Height="20" />
                            <ContentPresenter Grid.Column="1" x:Name="Label" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource NavHover}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Lime}" />
                <Setter Property="Foreground" Value="{StaticResource Green}" />
                <Setter Property="FontWeight" Value="650" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .seg button -->
    <Style x:Key="SegItem" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Foreground" Value="{StaticResource SegFg}" />
        <Setter Property="Background" Value="{StaticResource Clear}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="600" />
        <Setter Property="Padding" Value="17,10" />
        <Setter Property="MinHeight" Value="35" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Green}" />
                <Setter Property="Foreground" Value="{StaticResource White}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Seg" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SegBg}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- .workflow-action -->
    <Style x:Key="WorkflowAction" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Clear}" />
        <Setter Property="Padding" Value="0,20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <c:Icon Data="{TemplateBinding c:Ui.Icon}" Width="24" Height="24" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource WorkflowHover}" />
                <Setter Property="Foreground" Value="{StaticResource Green}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Input ===== -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Selection}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Tag" Value="{StaticResource Placeholder}" />
        <Setter Property="c:Ui.Radius" Value="8" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="11" BorderThickness="3" BorderBrush="{StaticResource Clear}" />
                        <Border x:Name="Bd" CornerRadius="{TemplateBinding c:Ui.Radius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <TextBlock x:Name="Hint" Margin="2,0" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{TemplateBinding Tag}"
                                           Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .fieldgroup input (formulir proyek baru) -->
    <Style x:Key="EntryInput" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderEntry}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="49" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Tag" Value="{StaticResource PlaceholderEntry}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="11" BorderThickness="3" BorderBrush="{StaticResource Clear}" />
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                <TextBlock x:Name="Hint" Margin="2,0" Text="{TemplateBinding c:Ui.Placeholder}" Foreground="{TemplateBinding Tag}"
                                           Visibility="Collapsed" IsHitTestVisible="False" TextTrimming="CharacterEllipsis" />
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FocusRingEntry}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBorderEntry}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Select ===== -->
    <Style x:Key="SelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="13,7" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource Clear}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter RecognizesAccessKey="False" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource Lime}" />
                <Setter Property="Foreground" Value="{StaticResource Green}" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Background" Value="{StaticResource Green}" />
                <Setter Property="Foreground" Value="{StaticResource White}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="SelectToggle" TargetType="ToggleButton">
        <Border Background="Transparent" />
    </ControlTemplate>

    <Style x:Key="Select" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="17,0,36,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SelectItem}" />
        <Setter Property="Tag" Value="{StaticResource FocusRing}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Ring" Margin="-3" CornerRadius="11" BorderThickness="3" BorderBrush="{StaticResource Clear}" />
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" RecognizesAccessKey="False" />
                        <Path Data="{StaticResource IcoChevron}" Stroke="{StaticResource Ink}" StrokeThickness="1.8" Width="9" Height="5"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        <ToggleButton Template="{StaticResource SelectToggle}" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" Focusable="False" AllowsTransparency="False"
                               PopupAnimation="None" IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{StaticResource White}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1"
                                    TextElement.FontFamily="{StaticResource Inter}" TextElement.FontSize="14">
                                <ScrollViewer CanContentScroll="False">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EntrySelect" TargetType="ComboBox" BasedOn="{StaticResource Select}">
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderEntry}" />
        <Setter Property="MinHeight" Value="49" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="18,0,36,0" />
        <Setter Property="Tag" Value="{StaticResource FocusRingEntry}" />
    </Style>

    <!-- ===== Input tanggal ===== -->
    <Style x:Key="DateText" TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
        <Setter Property="SelectionBrush" Value="{StaticResource Selection}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePickerTextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="CalendarButton" TargetType="Button">
        <Border Background="Transparent">
            <Path Data="{StaticResource IcoCalendar}" Stroke="{StaticResource Ink}" StrokeThickness="1.7" Width="16" Height="16"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </ControlTemplate>
    <Style x:Key="DateInput" TargetType="DatePicker">
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="SelectedDateFormat" Value="Short" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Ring" Margin="-3" CornerRadius="11" BorderThickness="3" BorderBrush="{StaticResource Clear}" />
                        <Border x:Name="Bd" CornerRadius="8" Background="{StaticResource White}" BorderBrush="{StaticResource InputBorder}" BorderThickness="1" SnapsToDevicePixels="True">
                            <Grid>
                                <DatePickerTextBox x:Name="PART_TextBox" Style="{StaticResource DateText}" Margin="13,0,40,0" VerticalAlignment="Center" />
                                <Button x:Name="PART_Button" Template="{StaticResource CalendarButton}" Width="40" HorizontalAlignment="Right" Focusable="False" Cursor="Hand" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Bd}" StaysOpen="False" AllowsTransparency="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource FocusRing}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBorder}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Scrollbar tipis (overlay, tidak memakan lebar konten) ===== -->
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{StaticResource ScrollThumbBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="3,2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource ScrollThumbHover}" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{StaticResource ScrollThumbHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SlimScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Style="{StaticResource SlimScrollBar}" HorizontalAlignment="Right"
                                   Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                   Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Permukaan ===== -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
